# The base URL for the backend API.
# Note: For Android emulator, use http://10.0.2.2:<port>
# For a physical device, use your computer's local IP (e.g., http://192.168.1.100:<port>)
# 'localhost' refers to the phone/emulator itself, which will not reach your computer.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api
